# SpicyRx environment variables
# Copy to .env.local for development; set these in Vercel for production.

# Rimo-hosted patient portal. Marketing-site CTAs redirect here.
# Pending Rimo confirmation on whether portal stays at app.caliberrx.co
# or moves to app.spicyrx.com.
NEXT_PUBLIC_RIMO_PORTAL_URL=https://app.caliberrx.co

# PostHog analytics + feature flags.
# Get keys from https://us.posthog.com → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
