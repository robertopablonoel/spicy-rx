# SpicyRx environment variables
# Copy to .env.local for development; set these in Vercel for production.

# Rimo two-surface architecture.
#
# INTAKE  — patient-facing sales channel (SpicyRx-branded). Primary CTA
#           target. The path segment `sh-rhdbd4` is the sales-channel ID
#           Rimo provisioned for this brand.
# PORTAL  — returning-patient login (Caliber-branded). Used for "Sign in"
#           style CTAs once we add one. Pending Rimo decision on whether
#           to re-provision under spicyrx.com to match the intake brand.
NEXT_PUBLIC_RIMO_INTAKE_URL=https://my.spicyrx.com/intake/sh-rhdbd4/date-of-birth
NEXT_PUBLIC_RIMO_PORTAL_URL=https://app.caliberrx.co

# Passion (female product line) intake channel. Passion is a separate Rimo
# offering and needs its OWN sales-channel ID — leave blank until Roberto
# provisions it; the site falls back to the Hot Sauce intake URL meanwhile.
NEXT_PUBLIC_RIMO_INTAKE_PASSION_URL=

# PostHog analytics + feature flags.
# Get keys from https://us.posthog.com → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Ads conversion tracking.
# The conversion ID is public and hardcoded as a default in lib/constants.ts,
# so the base tag ships live WITHOUT these — only set them to override.
#   ID    — the AW-… conversion ID (leave blank to use the hardcoded default).
#   LABEL — the "Begin Consultation" conversion action's label from the Ads UI
#           (Goals → Conversions → Website action, gtag event method). Until
#           set, the base tag is live but the CTA conversion event no-ops.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONSULT_LABEL=
